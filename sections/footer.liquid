
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer
  class="umino-footer"
  style="
    --uf-bg: {{ section.settings.background }};
    --uf-text: {{ section.settings.text_color }};
    --uf-heading: {{ section.settings.heading_color }};
    --uf-line: {{ section.settings.border_color }};
    --uf-width: {{ section.settings.content_width }}px;
  "
>
  <div class="umino-footer__container">

    <div class="umino-footer__main">

      <!-- COLUMN 1: BRAND -->
      <div class="umino-footer__brand">
        <a href="{{ routes.root_url }}" class="umino-footer__logo">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 240
              | image_tag:
                loading: 'lazy',
                widths: '120, 180, 240',
                alt: shop.name
            }}
          {% else %}
            <span class="umino-footer__logo-text">
              {{ section.settings.brand_name | escape }}
            </span>
          {% endif %}
        </a>

        <div class="umino-footer__contact">
          <p>{{ section.settings.address | escape }}</p>
          <p>
            <a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">
              {{ section.settings.phone | escape }}
            </a>
          </p>
          <p>
            <a href="mailto:{{ section.settings.email | escape }}">
              {{ section.settings.email | escape }}
            </a>
          </p>
        </div>

        <div class="umino-footer__social">
          {% assign social_names = 'instagram,tiktok,youtube,x,facebook' | split: ',' %}

          {% for social_name in social_names %}
            {% assign social_setting = 'social_' | append: social_name %}
            {% assign social_url = section.settings[social_setting] %}

            {% if social_url != blank %}
              <a
                href="{{ social_url }}"
                class="umino-footer__social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="{{ social_name | escape }}"
              >
                {% case social_name %}
                  {% when 'instagram' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5"/>
                      <circle cx="12" cy="12" r="4"/>
                      <circle cx="17.5" cy="6.5" r="1" class="uf-dot"/>
                    </svg>
                  {% when 'tiktok' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M14 3h3c.3 2 1.4 3.8 4 4v3.2c-2.1 0-4-.8-5.5-2.1v7.1a5.5 5.5 0 1 1-5.5-5.5c.5 0 1 .1 1.5.2v3.3a2.5 2.5 0 1 0 1 2V3z"/>
                    </svg>
                  {% when 'youtube' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect x="2" y="5" width="20" height="14" rx="4"/>
                      <path d="m10 9 5 3-5 3z" class="uf-solid"/>
                    </svg>
                  {% when 'x' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 3h4.5l11.5 18h-4.5L4 3z"/>
                      <path d="M20 3 4 21"/>
                    </svg>
                  {% when 'facebook' %}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M14 21v-8h3l.5-4H14V7c0-1.2.4-2 2-2h2V1.5c-.7-.2-1.7-.3-3-.3-3.4 0-5.5 2-5.5 5.7V9H6v4h3.5v8H14z" class="uf-solid"/>
                    </svg>
                {% endcase %}
              </a>
            {% endif %}
          {% endfor %}
        </div>

        {% if section.settings.show_shop_follow %}
          <a
            class="umino-footer__shop-follow"
            href="{{ section.settings.shop_follow_url | default: 'https://shop.app/' }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="umino-footer__shop-heart">♥</span>
            <span>Follow on <strong>shop</strong></span>
          </a>
        {% endif %}
      </div>

      <!-- COLUMN 2: HOT CATEGORIES -->
      <details class="umino-footer__column umino-footer__categories" open>
        <summary class="umino-footer__column-title">
          {{ section.settings.categories_heading | escape }}
          <span class="umino-footer__toggle" aria-hidden="true"></span>
        </summary>

        {% assign categories_menu = section.settings.categories_menu %}

        <ul class="umino-footer__links">
          {% if categories_menu != blank %}
            {% for link in categories_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ routes.all_products_collection_url }}">Special Offers</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Performance</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">T-shirts</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Underwear</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Top Brands</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Online Exclusive</a></li>
          {% endif %}
        </ul>
      </details>

      <!-- COLUMN 3: CUSTOMER SERVICE -->
      <details class="umino-footer__column umino-footer__service" open>
        <summary class="umino-footer__column-title">
          {{ section.settings.service_heading | escape }}
          <span class="umino-footer__toggle" aria-hidden="true"></span>
        </summary>

        {% assign service_menu = section.settings.service_menu %}

        <ul class="umino-footer__links">
          {% if service_menu != blank %}
            {% for link in service_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          {% else %}
            {% for policy in shop.policies %}
              {% if policy != blank %}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {% endif %}
            {% endfor %}
            <li><a href="{{ routes.search_url }}">Advanced Search</a></li>
            <li><a href="{{ pages['theme-faqs'].url | default: routes.root_url }}">Theme FAQs</a></li>
            <li><a href="{{ pages['store-locations'].url | default: routes.root_url }}">Store Locations</a></li>
          {% endif %}
        </ul>
      </details>

      <!-- COLUMN 4: NEWSLETTER -->
      <details class="umino-footer__column umino-footer__newsletter" open>
        <summary class="umino-footer__column-title">
          {{ section.settings.newsletter_heading | escape }}
          <span class="umino-footer__toggle" aria-hidden="true"></span>
        </summary>

        <p class="umino-footer__newsletter-text">
          {{ section.settings.newsletter_description | escape }}
        </p>

        {% form 'customer', class: 'umino-footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <label class="uf-visually-hidden" for="UminoFooterEmail-{{ section.id }}">
            Email address
          </label>

          <input
            id="UminoFooterEmail-{{ section.id }}"
            class="umino-footer__email"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.email_placeholder | escape }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            required
          >

          <button type="submit" class="umino-footer__subscribe">
            {{ section.settings.subscribe_text | escape }}
          </button>

          {% if form.posted_successfully? %}
            <p class="umino-footer__message" role="status">
              {{ section.settings.success_message | escape }}
            </p>
          {% endif %}

          {% if form.errors %}
            <div class="umino-footer__message" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        {% endform %}
      </details>

    </div>

    <!-- BOTTOM BAR -->
   <!-- BOTTOM BAR -->
<div class="umino-footer__bottom">

  <div class="umino-footer__localization">

    {% if section.settings.show_language %}
      {% if localization.available_languages.size > 1 %}

        {% form 'localization', id: 'UminoFooterLanguage' %}
          <label
            class="uf-visually-hidden"
            for="UminoFooterLanguageSelect"
          >
            Language
          </label>

          <select
            id="UminoFooterLanguageSelect"
            name="language_code"
            onchange="this.form.submit()"
          >
            {% for language in localization.available_languages %}
              <option
                value="{{ language.iso_code }}"
                {% if language.iso_code == localization.language.iso_code %}
                  selected
                {% endif %}
              >
                {{ language.endonym_name }}
              </option>
            {% endfor %}
          </select>
        {% endform %}

      {% else %}
        <span>
          {{ localization.language.endonym_name | default: 'English' }}
        </span>
      {% endif %}
    {% endif %}

    {% if section.settings.show_currency %}
      {% if localization.available_countries.size > 1 %}

        {% form 'localization', id: 'UminoFooterCountry' %}
          <label
            class="uf-visually-hidden"
            for="UminoFooterCountrySelect"
          >
            Country and currency
          </label>

          <select
            id="UminoFooterCountrySelect"
            name="country_code"
            onchange="this.form.submit()"
          >
            {% for country in localization.available_countries %}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == localization.country.iso_code %}
                  selected
                {% endif %}
              >
                {{ country.name }}
                ({{ country.currency.iso_code }}
                {{ country.currency.symbol }})
              </option>
            {% endfor %}
          </select>
        {% endform %}

      {% else %}
        <span>
          {{ localization.country.name | default: 'United States' }}
          ({{ localization.country.currency.iso_code | default: 'USD' }}
          {{ localization.country.currency.symbol | default: '$' }})
        </span>
      {% endif %}
    {% endif %}

  </div>

  <div class="umino-footer__copyright">
    {{ section.settings.copyright | escape }}
  </div>

  {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
    <ul class="umino-footer__payments" aria-label="Accepted payment methods">
      {% for type in shop.enabled_payment_types %}
        <li>{{ type | payment_type_svg_tag }}</li>
      {% endfor %}
    </ul>
  {% endif %}

</div>

  </div>
</footer>

<script>
  (() => {
    const footer = document.currentScript.previousElementSibling;
    if (!footer || !footer.classList.contains('umino-footer')) return;

    const columns = footer.querySelectorAll('.umino-footer__column');
    const categories = columns[0];
    const service = columns[1];
    const newsletter = columns[2];

    const setMobileDefaults = () => {
      if (window.innerWidth <= 749) {
        if (categories) categories.open = false;
        if (service) service.open = true;
        if (newsletter) newsletter.open = true;
      } else {
        columns.forEach((column) => {
          column.open = true;
        });
      }
    };

    setMobileDefaults();
    window.addEventListener('resize', setMobileDefaults, { passive: true });
  })();
</script>

