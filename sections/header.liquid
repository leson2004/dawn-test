</svg>

          {% if cart.item_count > 0 %}
            <span class="site-header__cart-count">
              {{ cart.item_count }}
            </span>
          {% endif %}
        </a>
      {% endif %}
    </div>
  </div>

  <!-- Mobile menu overlay -->
  <div
    class="site-header__overlay"
    data-menu-overlay
    hidden
  ></div>

  <!-- Mobile navigation drawer -->
  <nav
    id="MobileMenu-{{ section.id }}"
    class="site-header__mobile-menu"
    aria-label="Mobile navigation"
    aria-hidden="true"
    inert
    data-mobile-menu
  >
    <div class="site-header__mobile-menu-header">
      <span class="site-header__mobile-menu-title">
        {{ shop.name | escape }}
      </span>

      <button
        class="site-header__icon-button"
        type="button"
        aria-label="Close menu"
        data-menu-close
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>
      </button>
    </div>

    {% if header_menu != blank %}
      <ul class="site-header__mobile-links">
        {% for link in header_menu.links %}
          <li>
            <a href="{{ link.url }}">
              {{ link.title | escape }}
            </a>

            {% if link.links != blank %}
              <ul class="site-header__mobile-submenu">
                {% for child_link in link.links %}
                  <li>
                    <a href="{{ child_link.url }}">
                      {{ child_link.title | escape }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </nav>
</header>

{% schema %}
{
  "name": "UMINO Header",
  "tag": "section",
  "class": "header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Desktop logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Desktop logo width",
      "min": 60,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 50,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 48,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist page URL"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text and icon color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "UMINO Header"
    }
  ]
}
{% endschema %}
