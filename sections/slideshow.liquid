
{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-slideshow.js' | asset_url }}" defer></script>

<section
  id="HeroSlideshow-{{ section.id }}"
  class="hero-slideshow"
  data-hero-slideshow
  data-section-id="{{ section.id }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
  style="
    --hero-height: {{ section.settings.desktop_height }}px;
    --hero-mobile-height: {{ section.settings.mobile_height }}px;
    {% comment %} --hero-content-width: {{ section.settings.content_width }}%; {% endcomment %}
    --hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-bg: {{ section.settings.background_color }};
    --hero-text: {{ section.settings.text_color }};
    --hero-button-bg: {{ section.settings.button_background }};
    --hero-button-text: {{ section.settings.button_text_color }};
  "
>
  {% if section.blocks.size > 0 %}
    <div class="hero-slideshow__viewport" data-hero-viewport>
      {% for block in section.blocks %}
        {% liquid
          assign slide_alt = block.settings.image.alt | default: block.settings.heading
          assign slide_image = block.settings.image
          assign slide_mobile_image = block.settings.mobile_image | default: slide_image
        %}

        <article
          class="hero-slide{% if forloop.first %} is-active{% endif %}"
          data-hero-slide
          data-slide-index="{{ forloop.index0 }}"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ section.blocks.size }}"
          {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
          {{ block.shopify_attributes }}
        >
          {% if slide_image != blank %}
            <picture class="hero-slide__picture">
              {% if slide_mobile_image != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ slide_mobile_image | image_url: width: 1000 }}"
                >
              {% endif %}

              {{
                slide_image
                | image_url: width: 2400
                | image_tag:
                  class: 'hero-slide__image',
                  widths: '750, 1100, 1500, 1800, 2200, 2400',
                  sizes: '100vw',
                  loading: 'lazy',
                  alt: slide_alt
              }}
            </picture>
          {% else %}
            <div class="hero-slide__image-placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="hero-slide__overlay"></div>

            <div class="hero-slide__content hero-slide__content--{{ block.settings.content_position }}">
              {% if block.settings.subheading != blank %}
                <p class="hero-slide__eyebrow">
                  {{ block.settings.subheading | escape }}
                </p>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h2 class="hero-slide__heading">
                  {{ block.settings.heading | escape | newline_to_br }}
                </h2>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="hero-slide__description">
                  {{ block.settings.description | escape | newline_to_br }}
                </div>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a
                  class="hero-slide__button"
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% else %}
                    role="link"
                    aria-disabled="true"
                  {% endif %}
                >
                  {{ block.settings.button_label | escape }}
                </a>
              {% endif %}
            </div>
          
        </article>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      {% if section.settings.show_arrows %}
        <button
          type="button"
          class="hero-slideshow__arrow hero-slideshow__arrow--prev"
          data-hero-prev
          aria-label="Previous slide"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m15 18-6-6 6-6"
              fill="none" stroke="currentColor"
              stroke-width="1.5"/>
          </svg>
        </button>

        <button
          type="button"
          class="hero-slideshow__arrow hero-slideshow__arrow--next"
          data-hero-next
          aria-label="Next slide"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m9 18 6-6-6-6"
              fill="none" stroke="currentColor"
              stroke-width="1.5"/>
          </svg>
        </button>
      {% endif %}

      {% if section.settings.show_dots %}
        <div class="hero-slideshow__dots" aria-label="Choose slide">
          {% for block in section.blocks %}
            <button
              type="button"
              class="hero-slideshow__dot{% if forloop.first %} is-active{% endif %}"
              data-hero-dot
              data-slide-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}
  {% else %}
    <div class="hero-slideshow__empty">
      <p>Add a slide to display your hero banner.</p>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "UMINO Hero Slideshow",
  "tag": "section",
  "class": "hero-slideshow-section",
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop height",
      "min": 300,
      "max": 810,
      "step": 10,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 260,
      "max": 650,
      "step": 10,
      "unit": "px",
      "default": 550
    },
    
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto rotate slides",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slide interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Small heading"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "Stylish\nTop Trending"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "So soft you don't want to take it off."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "EXPLORE NOW"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "UMINO Hero Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide",
          "settings": {
            "heading": "New Season\nNew Style",
            "description": "Discover the latest arrivals."
          }
        }
      ]
    }
  ]
}
{% endschema %}
