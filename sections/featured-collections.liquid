
{{ 'section-featured-collections.css' | asset_url | stylesheet_tag }}

<section
  id="FeaturedCollections-{{ section.id }}"
  class="featured-collections"
  style="
    --fc-background: {{ section.settings.background_color }};
    --fc-text: {{ section.settings.text_color }};
    --fc-gap: {{ section.settings.card_gap }}px;
    --fc-radius: {{ section.settings.card_radius }}px;
    --fc-padding-top: {{ section.settings.padding_top }}px;
    --fc-padding-bottom: {{ section.settings.padding_bottom }}px;
    --fc-container-width: {{ section.settings.container_width }}px;
  "
>
  <div class="featured-collections__container">

    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="featured-collections__header">
        {% if section.settings.heading != blank %}
          <h2 class="featured-collections__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="featured-collections__description">
            {{ section.settings.description | escape | newline_to_br }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="featured-collections__grid featured-collections__grid--{{ section.settings.layout }}"
        style="--fc-columns: {{ section.settings.columns_desktop }};"
      >
        {% for block in section.blocks %}
          {% liquid
            assign selected_collection = block.settings.collection
            assign card_image = block.settings.image

            if card_image == blank and selected_collection != blank
              assign card_image = selected_collection.featured_image
            endif

            assign card_title = block.settings.custom_title

            if card_title == blank and selected_collection != blank
              assign card_title = selected_collection.title
            endif

            assign card_link = block.settings.custom_link

            if card_link == blank and selected_collection != blank
              assign card_link = selected_collection.url
            endif

            assign image_alt = card_image.alt | default: card_title
          %}

          <div
            class="featured-collections__item featured-collections__item--{{ block.settings.position }} featured-collections__item--{{ block.settings.card_size }}"
            {{ block.shopify_attributes }}
          >
            {% if card_link != blank %}
              <a
                class="featured-collections__card"
                href="{{ card_link }}"
                aria-label="{{ card_title | default: 'View collection' | escape }}"
              >
            {% else %}
              <div class="featured-collections__card">
            {% endif %}

                <div class="featured-collections__media">
                  {% if card_image != blank %}
                    {{
                      card_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'featured-collections__image',
                        widths: '320, 480, 640, 800, 1000, 1200',
                        sizes: '(min-width: 1200px) 33vw, (min-width: 750px) 33vw, 50vw',
                        loading: 'lazy',
                        alt: image_alt
                    }}
                  {% else %}
                    <div class="featured-collections__placeholder">
                      {{ 'collection-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                {% if section.settings.show_overlay %}
                  <div class="featured-collections__overlay"></div>
                {% endif %}

                {% if card_title != blank and section.settings.show_titles %}
                  <span class="featured-collections__label featured-collections__label--{{ section.settings.label_position }}">
                    {{ card_title | escape }}
                  </span>
                {% endif %}

            {% if card_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="featured-collections__empty">
        <p>Add collection blocks to display your collections.</p>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "featured-collections-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collections"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Elevate your style with our chic featured collection—where fashion meets flair effortlessly."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "masonry",
          "label": "Masonry"
        },
        {
          "value": "grid",
          "label": "Equal grid"
        }
      ],
      "default": "masonry"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_titles",
      "label": "Show collection labels",
      "default": true
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "Label position",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom center"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Enable image overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Content max width",
      "min": 900,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "default": 1410
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image",
          "info": "Overrides the collection featured image."
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom label",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom link",
          "info": "Leave blank to use the selected collection URL."
        },
        {
          "type": "select",
          "id": "position",
          "label": "Desktop position",
          "options": [
            {
              "value": "left",
              "label": "Left large"
            },
            {
              "value": "center_top",
              "label": "Center top"
            },
            {
              "value": "center_bottom",
              "label": "Center bottom"
            },
            {
              "value": "right",
              "label": "Right large"
            },
            {
              "value": "auto",
              "label": "Automatic"
            }
          ],
          "default": "auto"
        },
        {
          "type": "select",
          "id": "card_size",
          "label": "Card size",
          "options": [
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ],
          "default": "large"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        {
          "type": "collection_item",
          "settings": {
            "position": "left",
            "card_size": "large",
            "custom_title": "Clothing"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "position": "center_top",
            "card_size": "small",
            "custom_title": "Sunglasses"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "position": "center_bottom",
            "card_size": "small",
            "custom_title": "Bags"
          }
        },
        {
          "type": "collection_item",
          "settings": {
            "position": "right",
            "card_size": "large",
            "custom_title": "Sneaker"
          }
        }
      ]
    }
  ]
}
{% endschema %}
