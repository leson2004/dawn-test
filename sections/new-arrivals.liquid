
{{ 'section-new-arrivals.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-new-arrivals.js' | asset_url }}" defer></script>

<section
  id="NewArrivals-{{ section.id }}"
  class="new-arrivals"
  data-new-arrivals
  style="
    --na-bg: {{ section.settings.background_color }};
    --na-text: {{ section.settings.text_color }};
    --na-gap: {{ section.settings.card_gap }}px;
    --na-padding-top: {{ section.settings.padding_top }}px;
    --na-padding-bottom: {{ section.settings.padding_bottom }}px;
    --na-container-width: {{ section.settings.container_width }}px;
    --na-columns: {{ section.settings.columns_desktop }};
  "
>
  <div class="new-arrivals__container">
    <header class="new-arrivals__header">
      {% if section.settings.heading != blank %}
        <h2 class="new-arrivals__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="new-arrivals__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    {% assign selected_collection = section.settings.collection %}

    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      <div class="new-arrivals__carousel" data-na-carousel>
        {% if section.settings.show_arrows %}
          <div class="new-arrivals__controls">
            <button
              type="button"
              class="new-arrivals__arrow"
              data-na-prev
              aria-label="Previous products"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m15 18-6-6 6-6"
                  fill="none" stroke="currentColor"
                  stroke-width="1.5"/>
              </svg>
            </button>

            <button
              type="button"
              class="new-arrivals__arrow"
              data-na-next
              aria-label="Next products"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 18 6-6-6-6"
                  fill="none" stroke="currentColor"
                  stroke-width="1.5"/>
              </svg>
            </button>
          </div>
        {% endif %}

        <div class="new-arrivals__track" data-na-track>
          {% for product in selected_collection.products limit: section.settings.products_to_show %}
            <div class="new-arrivals__item" data-na-item>
              {% render 'product-card-new-arrivals', product: product %}
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_view_all %}
        <div class="new-arrivals__footer">
          <a
            class="new-arrivals__view-all"
            href="{{ selected_collection.url }}"
          >
            {{ section.settings.view_all_label | escape }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="new-arrivals__empty">
        {% if selected_collection == blank %}
          <p>Choose a collection in the New Arrivals section settings.</p>
        {% else %}
          <p>This collection has no products to display.</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "new-arrivals-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Here's some of our new arrivals products people are in love with.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating stars",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_color_swatches",
      "label": "Show color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All link",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All label",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Product gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Content max width",
      "min": 900,
      "max": 1600,
      "step": 10,
      "unit": "px",
      "default": 1410
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
